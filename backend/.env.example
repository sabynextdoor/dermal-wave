# ============================================================
# Dermal Wave - Backend Environment Configuration
# Copy this file to .env and fill in your real values.
# ============================================================

# PostgreSQL connection string (local or NeonDB)
# Local example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/dermalweave
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dermalweave"

# Clerk authentication
# Found in Clerk Dashboard -> your app -> API Keys
# Secret key (server-side only) AND publishable key (needed by @clerk/express middleware).
# The frontend also needs NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY="PASTE_YOUR_CLERK_SECRET_KEY_HERE"
CLERK_PUBLISHABLE_KEY="PASTE_YOUR_CLERK_PUBLISHABLE_KEY_HERE"

# Google Gemini API key
# Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# Optional JWT secret used for legacy token signing
JWT_SECRET="super-secret-dermalwave-key"
