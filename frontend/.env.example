# ============================================================
# Dermal Wave - Frontend Environment Configuration
# Copy this file to .env.local and fill in your real values.
# ============================================================

# Clerk authentication (Publishable key - safe to expose in the browser)
# Found in Clerk Dashboard -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="PASTE_YOUR_CLERK_PUBLISHABLE_KEY_HERE"

# Clerk secret key (server-side only - used by src/proxy.ts middleware)
CLERK_SECRET_KEY="PASTE_YOUR_CLERK_SECRET_KEY_HERE"

# Optional: Backend API base URL. Defaults to http://localhost:5000/api
# NEXT_PUBLIC_API_URL="http://localhost:5000/api"
